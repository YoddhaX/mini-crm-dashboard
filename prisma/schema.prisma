// Prisma schema for Prisma 7
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Lead {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  phone        String
  businessName String
  status       String   @default("New")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
